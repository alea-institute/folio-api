folio.openlegalstandard.org {
    encode gzip
    reverse_proxy api:{$PORT}
    tls {
        protocols tls1.2 tls1.3
    }
    log {
        # Keep ~1 year of access logs (Caddy's default keeps only 10 x 100 MiB,
        # about 24 days at current traffic). ~5.6 MB/day compressed.
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 1000
            roll_keep_for 8760h
        }
        format json
    }
    header {
        # Enable HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Enable Cross-Site Filter (XSS Protection)
        X-XSS-Protection "1; mode=block"
        # Disable clients from inferring the MIME type
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Remove the Server header
        -Server
    }
}

